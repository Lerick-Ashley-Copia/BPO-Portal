generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  employee
  team_leader
  manager
  hr
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  roles        Role[]   @default([employee])
  employee     Employee?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  teams     Team[]
  employees Employee[]

  @@map("departments")
}

model Team {
  id           String     @id @default(uuid())
  name         String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  employees    Employee[]

  @@map("teams")
}

model Employee {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @unique
  department Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  team       Team?     @relation(fields: [teamId], references: [id])
  teamId     String?
  position   String?
  status     String    @default("active")
  dateHired  DateTime?
  managerId  String?

  @@map("employees")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  authorId  String
  published Boolean   @default(false)
  publishAt DateTime?
  expireAt  DateTime?
  createdAt DateTime  @default(now())

  @@map("announcements")
}

model Benefit {
  id          String   @id @default(uuid())
  title       String
  category    String
  description String
  eligibility String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefits")
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  documents Document[]

  @@map("document_categories")
}

model Document {
  id          String            @id @default(uuid())
  title       String
  category    DocumentCategory  @relation(fields: [categoryId], references: [id])
  categoryId  String
  storageKey  String
  accessLevel Role              @default(employee)
  uploadedBy  String
  createdAt   DateTime          @default(now())

  @@map("documents")
}

enum ReportStatus {
  draft
  submitted
  reviewed
  approved
  rejected
}

model WeeklyReport {
  id          String       @id @default(uuid())
  teamId      String
  periodStart DateTime
  periodEnd   DateTime
  status      ReportStatus @default(draft)
  submittedBy String?
  data        Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("weekly_reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  result     String
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
