{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "devCommand": null,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/employees/me", "destination": "/api/employees?sub=me" },
    { "source": "/api/employees/:id", "destination": "/api/employees?sub=:id" },
    { "source": "/api/users/:id", "destination": "/api/users?sub=:id" },
    { "source": "/api/documents/:id/download", "destination": "/api/documents?sub=:id" },
    { "source": "/api/announcements/:id", "destination": "/api/announcements?sub=:id" },
    { "source": "/api/benefits/:id", "destination": "/api/benefits?sub=:id" },
    { "source": "/api/reports/:id/export", "destination": "/api/reports?sub=:id" },
    { "source": "/api/reports/:id", "destination": "/api/reports?sub=:id" },
    { "source": "/api/leave/requests", "destination": "/api/leave?resource=requests" },
    { "source": "/api/leave/requests/:id", "destination": "/api/leave?resource=requests&sub=:id" },
    { "source": "/api/leave/attendance", "destination": "/api/leave?resource=attendance" },
    { "source": "/api/leave/attendance/today", "destination": "/api/leave?resource=attendance&sub=today" },
    { "source": "/api/leave/attendance/checkin", "destination": "/api/leave?resource=attendance&sub=checkin" },
    { "source": "/api/leave/attendance/checkout", "destination": "/api/leave?resource=attendance&sub=checkout" },
    { "source": "/api/leave/attendance/export", "destination": "/api/leave?resource=attendance&sub=export" }
  ]
}
